{
  "name": "wham-engine",
  "version": "1.0.0",
  "description": "Unified Model Context Protocol (MCP) server suite of 200 deterministic micro-tools gated by x402 Base L2 micropayments.",
  "main": "dist/ecosystem/hub_server.js",
  "bin": {
    "wham-engine": "./bin/cli.js"
  },
  "type": "module",
  "files": [
